generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

model Role {
  roleId      Int    @id @default(autoincrement())
  description String
  level       Int

  users User[]

  @@map("roles")
}

model User {
  userId       Int      @id @default(autoincrement())
  username     String   @unique
  passwordHash String
  name         String
  surname      String
  birthDate    DateTime

  roleId Int
  role   Role @relation(fields: [roleId], references: [roleId])

  deals      Deal[]
  activities Activity[]

  sessions Session[]

  @@map("users")
}

model Company {
  companyId Int    @id @default(autoincrement())
  name      String
  address   String
  piva      String @unique

  contacts Contact[]

  @@map("companies")
}

model Contact {
  contactId Int      @id @default(autoincrement())
  name      String
  surname   String

  companyId Int?
  company   Company? @relation(fields: [companyId], references: [companyId])

  deals Deal[]

  @@map("contacts")
}

model DealState {
  dealStateId Int    @id @default(autoincrement())
  code        String @unique
  slug        String @unique
  label       String
  sequence       Int

  deals Deal[]

  @@map("deal_states")
}

model Deal {
  dealId           Int      @id @default(autoincrement())
  title            String
  value            Decimal  @db.Decimal(12, 2)
  dateCreation     DateTime @default(now())
  dateLastModified DateTime @updatedAt

  dealStateId Int
  dealState   DealState @relation(fields: [dealStateId], references: [dealStateId])

  userId Int
  user   User @relation(fields: [userId], references: [userId])

  contactId Int
  contact   Contact @relation(fields: [contactId], references: [contactId])

  activities Activity[]

  @@map("deals")
}

model ActivityType {
  activityTypeId Int    @id @default(autoincrement())
  code           String @unique
  label          String

  activities Activity[]

  @@map("activity_types")
}

model Activity {
  activityId  Int      @id @default(autoincrement())
  description String
  date        DateTime

  dealId Int
  deal   Deal @relation(fields: [dealId], references: [dealId])

  userId Int
  user   User @relation(fields: [userId], references: [userId])

  activityTypeId Int
  activityType   ActivityType @relation(fields: [activityTypeId], references: [activityTypeId])

  @@map("activities")
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       Int
  expires      DateTime
  user         User     @relation(fields: [userId], references: [userId], onDelete: Cascade)
}